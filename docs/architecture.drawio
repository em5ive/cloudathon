gt;+ temporary bootstrap" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#ed7100;strokeColor=#ffffff;fontColor=#0f172a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1270" y="515" width="78" height="78" as="geometry" /></mxCell><mxCell id="epa" value="Conditional endpoints A&lt;br&gt;Optional Bedrock + bootstrap-only Secrets" style="shape=mxgraph.aws4.endpoints;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#8c4fff;strokeColor=none;fontColor=#0f172a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="520" width="58" height="58" as="geometry" /></mxCell><mxCell id="epb" value="Conditional endpoints B&lt;br&gt;Remove Secrets ENIs after bootstrap" style="shape=mxgraph.aws4.endpoints;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#8c4fff;strokeColor=none;fontColor=#0f172a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1540" y="520" width="58" height="58" as="geometry" /></mxCell><mxCell id="proxy" value="RDS Proxy - Multi-AZ&lt;br&gt;TLS required / IAM client auth&lt;br&gt;Default writer endpoint" style="shape=mxgraph.aws4.rds_proxy;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#c925d1;strokeColor=none;fontColor=#0f172a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1165" y="650" width="78" height="78" as="geometry" /></mxCell><mxCell id="writer" value="Aurora PostgreSQL writer&lt;br&gt;Serverless v2 / private / SSL forced" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#c925d1;strokeColor=#ffffff;fontColor=#0f172a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="880" y="805" width="78" height="78" as="geometry" /></mxCell><mxCell id="reader" value="Aurora PostgreSQL reader&lt;br&gt;Promotable in other AZ" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;aspect=fixed;fillColor=#c925d1;strokeColor=#ffffff;fontColor=#0f172a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1370" y="805" width="78" height="78" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Security and evidence&lt;/b&gt;&lt;br&gt;Lambda SG ? Proxy SG ? DB SG: TCP 5432 only. Client verifies hostname + certificate; AWS roots and RDS CA bundle packaged.&lt;br&gt;Proxy ? Aurora uses TLS and Secrets Manager credentials. No custom domain or ACM resource. App role has limited SQL permissions.&lt;br&gt;Lambda icons depict the same three managed functions configured for both subnets, not six fixed servers. No full-region DR claim.&lt;br&gt;AWS4 built-in official service icons are editable; live deployment, HTTPS and failover tests remain blocked pending AWS authentication and approval." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="35" y="1100" width="1720" height="85" as="geometry" /></mxCell><mxCell id="e1" value="HTTPS / static" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontColor=#0f172a;fontSize=12;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="browser" target="cf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="OAC signed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontColor=#0f172a;fontSize=12;lab